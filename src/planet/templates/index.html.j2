<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ name }}</title>
    <meta name="description" content="{{ name }} collects posts from blogs about Clojure.">
    <meta name="generator" content="{{ generator }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)">
    <link rel="preload" href="/static/fonts/ibm-plex-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ stylesheet }}">
    <link rel="alternate" type="application/atom+xml" href="{{ feed }}" title="{{ name }}">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/i/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/i/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/i/apple-touch-icon.png">
    <link rel="manifest" href="/static/i/site.webmanifest">
  </head>
  <body>
    <a class="skip" href="#content">Skip to posts</a>

    <header class="site-header">
      <div class="brand">
        <img class="logo" src="/static/i/planet-logo.svg" alt="" width="220" height="220">
        <p class="site-title"><a href="{{ link }}">{{ name }}</a></p>
        <p class="tagline">Posts from blogs about Clojure, collected every hour.</p>
      </div>
      <nav class="site-nav" aria-label="Site">
        <a href="{{ feed }}">Atom feed</a>
        <a href="#subscriptions">Subscriptions</a>
      </nav>
    </header>

    <div class="layout">
      <main id="content">
        {%- for entry in entries %}
        {%- set item = entry.item %}
        <article class="entry">
          <p class="entry-meta">
            {%- if item.channel.meta.link %}
            <a class="blog" href="{{ item.channel.meta.link }}">{{ item.channel.name }}</a>
            {%- else %}
            <span class="blog">{{ item.channel.name }}</span>
            {%- endif %}
            <time datetime="{{ item.date | iso }}">{{ item.date | date(date_format) }}</time>
          </p>
          <h2 class="entry-title"{% if item.title_language %} lang="{{ item.title_language }}"{% endif %}>
            {%- if item.link %}<a href="{{ item.link }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif -%}
          </h2>
          <div class="content"{% if item.content_language %} lang="{{ item.content_language }}"{% endif %}>
            {{ entry.visible | safe }}
            {%- if entry.more %}
            <details class="more">
              <summary class="button"><span class="when-closed">Read more</span><span class="when-open">Show less</span></summary>
              {{ entry.more | safe }}
            </details>
            {%- endif %}
          </div>
        </article>
        {%- else %}
        <p>No posts yet.</p>
        {%- endfor %}
      </main>

      <aside class="sidebar" aria-label="About and subscriptions">
        <section>
          <h2>About</h2>
          <p>{{ name }} is a meta blog that collects posts from the blogs of <a href="https://clojure.org/">Clojure</a> hackers and contributors.</p>
          <p>It is edited by <a href="http://freegeek.in/">Baishampayan Ghose</a> and <a href="http://alexott.net/en/index.html">Alex Ott</a>. Please <a href="https://github.com/ghoseb/planet.clojure">send them a patch</a> if you want your blog to be syndicated here.</p>
        </section>

        <section>
          <h2>Search</h2>
          <form class="search" action="https://www.google.com/cse" role="search">
            <input type="hidden" name="cx" value="013940287744875509343:60ybe0lrjm4">
            <input type="hidden" name="ie" value="UTF-8">
            <input type="search" name="q" aria-label="Search the blogs">
            <button type="submit">Search</button>
          </form>
        </section>

        <section id="subscriptions">
          <h2>Subscriptions</h2>
          <ul class="subscriptions">
            {%- for channel in channels %}
            <li><a {% if channel.meta.link %}href="{{ channel.meta.link }}" {% endif %}{% if channel.message %}class="message" title="{{ channel.message }}"{% else %}title="{{ (channel.meta.title or '') | plain }}"{% endif %}>{{ channel.name }}</a></li>
            {%- endfor %}
          </ul>
        </section>

        <section>
          <h2>Planetarium</h2>
          <ul>
            <li><a href="http://planet.lisp.org/">Planet Lisp</a></li>
            <li><a href="https://planet.scheme.org">Planet Scheme</a></li>
            <li><a href="https://planet.haskell.org">Planet Haskell</a></li>
            <li><a href="http://planet.python.org">Planet Python</a></li>
          </ul>
        </section>

        <section>
          <h2>Syndicate</h2>
          <ul>
            <li><a href="{{ feed }}">Atom feed</a></li>
          </ul>
        </section>
      </aside>
    </div>

    <footer class="site-footer">
      <p>{{ name }} is maintained by <a href="http://freegeek.in/">Baishampayan Ghose</a> and <a href="http://alexott.net/en/index.html">Alex Ott</a>. <a href="https://github.com/ghoseb/planet.clojure">Source on GitHub</a>.</p>
      <p>Posts are copyright their authors. Clojure and the Clojure logo are copyright Rich Hickey.</p>
      <p>Planet Clojure logo designed by <a href="https://tonsky.me/design/">Nikita Tonsky</a>.</p>
      <p>Updated <time datetime="{{ now | iso }}">{{ now | date(date_format) }}</time> UTC.</p>
    </footer>
  </body>
</html>
